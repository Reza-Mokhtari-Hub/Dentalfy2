# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string for serverless data persistence
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/dentalfy?retryWrites=true&w=majority"

# Cloudinary URL for secure server-side image, video, and PDF uploads
CLOUDINARY_URL="cloudinary://<your_api_key>:<your_api_secret>@w6wcgs6h"

# Gmail SMTP configuration for sending OTP verification codes
GMAIL_USER="your-email@gmail.com"
GMAIL_PASS="your-16-character-gmail-app-password"
